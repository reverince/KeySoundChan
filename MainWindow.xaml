<Window x:Class="KeySoundChan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeySoundChan.ViewModels"
        Title="KeySoundChan" 
        Height="520" Width="420"
        MinHeight="450" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f">
    
    <Window.Resources>
        <!-- 컬러 팔레트 -->
        <Color x:Key="AccentColor">#7c3aed</Color>
        <Color x:Key="AccentLightColor">#a78bfa</Color>
        <Color x:Key="SurfaceColor">#18181b</Color>
        <Color x:Key="SurfaceLightColor">#27272a</Color>
        <Color x:Key="TextPrimaryColor">#fafafa</Color>
        <Color x:Key="TextSecondaryColor">#a1a1aa</Color>
        <Color x:Key="SuccessColor">#22c55e</Color>
        <Color x:Key="DangerColor">#ef4444</Color>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        
        <!-- 타이틀바 버튼 스타일 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3f3f46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#c42b1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 기본 버튼 스타일 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3f3f46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#52525b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 액센트 버튼 스타일 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8b5cf6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6d28d9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 위험 버튼 스타일 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                BorderBrush="#52525b"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7f1d1d"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 토글 스위치 스타일 -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="track" 
                                    Width="44" Height="24" 
                                    CornerRadius="12" 
                                    Background="#3f3f46"
                                    Cursor="Hand"/>
                            <Border x:Name="thumb" 
                                    Width="18" Height="18" 
                                    CornerRadius="9" 
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0"
                                    Cursor="Hand">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="thumbTranslate" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTranslate" 
                                                             Storyboard.TargetProperty="X" 
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTranslate" 
                                                             Storyboard.TargetProperty="X" 
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 슬라이더 Thumb 스타일 -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource AccentLightBrush}" Cursor="Hand">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.5" Color="{StaticResource AccentColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 슬라이더 스타일 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" CornerRadius="3" Background="#3f3f46" 
                                    VerticalAlignment="Center" Margin="10,0"/>
                            <Track x:Name="PART_Track" Margin="10,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" 
                                                        Background="{StaticResource AccentBrush}"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 콤보박스 스타일 -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" 
                                                Background="{StaticResource SurfaceLightBrush}" 
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <Grid>
                                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                                  HorizontalAlignment="Left" 
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock Text="▼" FontSize="8" 
                                                           HorizontalAlignment="Right" 
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3f3f46"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            </ToggleButton>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown" 
                                        Background="#1f1f23" 
                                        CornerRadius="8"
                                        BorderBrush="#3f3f46"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200"
                                        Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="#fafafa"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3f3f46"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#71717a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 스크롤바 스타일 -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3f3f46" Margin="1"
                                                        Opacity="0.6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       Grid.Column="1"
                                       Style="{StaticResource ModernScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#0a0a0f">
        <Grid>
            <!-- 메인 컨텐츠 -->
            <Grid>
                <!-- 배경 그라디언트 효과 -->
                <Border x:Name="MainBackground">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0a0a0f" Offset="0"/>
                            <GradientStop Color="#1a1025" Offset="0.5"/>
                            <GradientStop Color="#0a0a0f" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                
                <!-- 키 입력 시각 피드백 -->
                <Border x:Name="FeedbackBorder" 
                        Background="{StaticResource AccentBrush}" 
                        Opacity="{Binding FeedbackOpacity}"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <BlurEffect Radius="100"/>
                    </Border.Effect>
                </Border>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              Style="{StaticResource ModernScrollViewer}"
                              Padding="24,16,16,24">
                    <StackPanel>
                        <!-- 헤더 -->
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="⌨️ KeySoundChan" 
                                       FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            
                            <!-- 활성화 토글 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="활성화" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource ToggleSwitch}" 
                                          IsChecked="{Binding IsEnabled}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 통계 카드 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="오늘의 키 입력" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding KeyPressCount, StringFormat={}{0:N0}}" 
                                               FontSize="36" FontWeight="Bold"
                                               Foreground="{StaticResource AccentLightBrush}"/>
                                </StackPanel>
                                <TextBlock Text="🎹" FontSize="48" HorizontalAlignment="Right" Opacity="0.3"/>
                            </Grid>
                        </Border>
                        
                        <!-- 볼륨 조절 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🔊 볼륨" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" 
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource AccentLightBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Value="{Binding Volume}" 
                                        Minimum="0" Maximum="100" 
                                        Style="{StaticResource ModernSlider}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 키 다운 사운드 -->
                        <Border x:Name="KeyDownPanel" 
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" Padding="20" Margin="0,0,0,12"
                                AllowDrop="True"
                                Drop="KeyDownPanel_Drop"
                                DragOver="Panel_DragOver"
                                DragLeave="Panel_DragLeave">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="키 누를 때" 
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="KeyDownDropHint" 
                                                   Text="  📂 여기에 드롭!" 
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button Content="✕ 제거" 
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearKeyDownSoundCommand}"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding HasKeyDownSound, Converter={StaticResource BoolToVisConverter}}"/>
                                </Grid>
                                
                                <Border Background="#0f0f12" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding KeyDownSoundName}" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 파일 선택" 
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding SelectKeyDownSoundCommand}"/>
                                    <ComboBox x:Name="PresetComboBox"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                              Margin="8,0,0,0"
                                              MinWidth="120"
                                              SelectionChanged="PresetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="🎵 프리셋" IsSelected="True" IsEnabled="False"/>
                                        <ComboBoxItem Content="🔔 벨"/>
                                        <ComboBoxItem Content="👏 박수"/>
                                        <ComboBoxItem Content="🥁 퍼커션"/>
                                        <ComboBoxItem Content="🏓 탁구"/>
                                        <ComboBoxItem Content="💥 샷"/>
                                        <ComboBoxItem Content="🐭 찍찍"/>
                                        <ComboBoxItem Content="💀 샌즈"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- 키 업 사운드 -->
                        <Border x:Name="KeyUpPanel" 
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                AllowDrop="True"
                                Drop="KeyUpPanel_Drop"
                                DragOver="Panel_DragOver"
                                DragLeave="Panel_DragLeave">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬆️" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="키 뗄 때" 
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="KeyUpDropHint" 
                                                   Text="  📂 여기에 드롭!" 
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button Content="✕ 제거" 
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearKeyUpSoundCommand}"
                                            HorizontalAlignment="Right"
                                            Visibility="{Binding HasKeyUpSound, Converter={StaticResource BoolToVisConverter}}"/>
                                </Grid>
                                
                                <Border Background="#0f0f12" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding KeyUpSoundName}" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                
                                <Button Content="📁 파일 선택" 
                                        Style="{StaticResource AccentButton}"
                                        Command="{Binding SelectKeyUpSoundCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 이미지 기능 -->
                        <Border x:Name="ImagePanel"
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                AllowDrop="True"
                                Drop="ImagePanel_Drop"
                                DragOver="ImagePanel_DragOver"
                                DragLeave="ImagePanel_DragLeave">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼️" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="키 입력 이미지" 
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ImageDropHint" 
                                                   Text="  📂 여기에 드롭!" 
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="🔲 미니" 
                                                Style="{StaticResource ModernButton}"
                                                Padding="10,8"
                                                Command="{Binding ToggleMiniModeCommand}"
                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="✕ 제거" 
                                                Style="{StaticResource DangerButton}"
                                                Click="ClearImage_Click"
                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Border Background="#0f0f12" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                        MinHeight="120">
                                    <Grid>
                                        <TextBlock Text="{Binding ImageInfo}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                                        <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}}">
                                            <Image x:Name="PreviewImage" 
                                                   Source="{Binding CurrentImageSource}"
                                                   MaxHeight="120" 
                                                   HorizontalAlignment="Left"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            <TextBlock Text="{Binding ImageInfo}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 이미지 선택" 
                                            Style="{StaticResource AccentButton}"
                                            Click="SelectImage_Click"/>
                                    <TextBlock Text="여러 개 선택 가능" 
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                                
                                <!-- 미니 모드 옵션 -->
                                <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVisConverter}}"
                                            Margin="0,16,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="🔆 미니 모드 불투명도" 
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding MiniImageOpacity, StringFormat={}{0}%}" 
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider Value="{Binding MiniImageOpacity}" 
                                            Minimum="0" Maximum="100" 
                                            Style="{StaticResource ModernSlider}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- 옵션 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨ 시각 효과" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="키 입력 시 화면 번쩍임" 
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" 
                                          IsChecked="{Binding ShowVisualFeedback}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        
                        <!-- 트레이 옵션 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥 트레이로 최소화" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="최소화 시 시스템 트레이" 
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" 
                                          IsChecked="{Binding MinimizeToTray}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
